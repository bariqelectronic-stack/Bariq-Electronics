# =============================================================================
# Bariq Electronics — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# All variables without a default shown are REQUIRED for that feature.
# The app runs in demo mode (static data, no DB) if DATABASE_URL is not set.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# DATABASE  (required for orders, accounts, and admin features)
# ─────────────────────────────────────────────────────────────────────────────
# Providers: Neon (neon.tech), Supabase, Railway, or self-hosted PostgreSQL.
# Format:  postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/bariq_electronics"


# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION  (required when DATABASE_URL is set)
# ─────────────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_OPENSSL_OUTPUT"
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_OUTPUT"
NEXTAUTH_URL="https://yourdomain.com"


# ─────────────────────────────────────────────────────────────────────────────
# SITE  (public — safe to expose)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"


# ─────────────────────────────────────────────────────────────────────────────
# PAYMENTS  (each method is optional; activated only when its vars are present)
# ─────────────────────────────────────────────────────────────────────────────

# Bank Transfer — disabled until BANK_ACCOUNT_NUMBER is provided
BANK_NAME=""
BANK_ACCOUNT_TITLE="Bariq Electronics"
BANK_ACCOUNT_NUMBER=""
BANK_IBAN=""
BANK_BRANCH=""

# Cash on Delivery — enabled by default; set to false to disable
NEXT_PUBLIC_COD_ENABLED="true"

# JazzCash — disabled until all three vars are provided
# Docs: https://sandbox.jazzcash.com.pk/
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_RETURN_URL="https://yourdomain.com/checkout/confirm"

# EasyPaisa — disabled until both vars are provided
# Docs: https://easypaisa.com.pk/techintegration/
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_RETURN_URL="https://yourdomain.com/checkout/confirm"

# Stripe (international cards) — disabled until both vars are provided
# Docs: https://stripe.com/docs/keys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""


# ─────────────────────────────────────────────────────────────────────────────
# EMAIL  (optional; disabled until RESEND_API_KEY or SMTP vars are present)
# ─────────────────────────────────────────────────────────────────────────────
# Choose ONE provider. Resend is easiest for Next.js.

# Option A — Resend (recommended): https://resend.com
RESEND_API_KEY=""

# Option B — SMTP (Gmail, Outlook, custom mail server)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# Used as the "From" address regardless of provider
EMAIL_FROM="bariqelectronic@gmail.com"


# ─────────────────────────────────────────────────────────────────────────────
# ANALYTICS  (optional; both are independent)
# ─────────────────────────────────────────────────────────────────────────────
# Google Analytics 4 — https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Meta (Facebook) Pixel — https://business.facebook.com/events_manager
NEXT_PUBLIC_META_PIXEL_ID=""


# ─────────────────────────────────────────────────────────────────────────────
# SOCIAL LINKS  (optional; empty = hidden in footer)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""


# ─────────────────────────────────────────────────────────────────────────────
# ADDRESS  (optional; shown in footer and contact page)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADDRESS_LINE1=""
NEXT_PUBLIC_ADDRESS_CITY="Karachi"


# ─────────────────────────────────────────────────────────────────────────────
# ADMIN SEED  (only used when running: npm run db:seed)
# ─────────────────────────────────────────────────────────────────────────────
# If set, this password is used for the seeded admin account.
# If not set, a secure random password is generated and printed to the terminal.
# Either way, mustChangePassword is set to true — you must change it on login.
# ADMIN_INITIAL_PASSWORD=""


# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT  (optional; only needed for automated deployments)
# ─────────────────────────────────────────────────────────────────────────────
# Vercel CLI/deployment token — get from: https://vercel.com/account/tokens
VERCEL_TOKEN=""
